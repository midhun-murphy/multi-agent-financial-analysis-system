# =============================================================================
# Environment Configuration — Multi-Agent Financial Statement Analysis System
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME="Multi-Agent Financial Statement Analysis System"
APP_VERSION="1.0.0"
APP_ENV="development"
DEBUG=false
LOG_LEVEL="INFO"

# --- Server ------------------------------------------------------------------
HOST="0.0.0.0"
PORT=8000
ALLOWED_ORIGINS="http://localhost:8080,http://127.0.0.1:8080"

# --- LLM Provider ------------------------------------------------------------
# Options: gemini | openai | claude
LLM_PROVIDER="gemini"

# Google Gemini (default)
GOOGLE_API_KEY=AQ.Ab8RN6LMT1EAgvxURIG7ujgcUD9Cv4z7nXh1Tp1ch-VNfYo8gg
GEMINI_MODEL="gemini-2.0-flash"

# OpenAI (future V2 — leave blank if not using)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Anthropic Claude (future V2 — leave blank if not using)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# --- Finance APIs ------------------------------------------------------------
# Yahoo Finance (yfinance) — No key required
YAHOO_FINANCE_ENABLED=true

# Finnhub — https://finnhub.io/
FINNHUB_API_KEY=d8mp121r01qn3046hkjgd8mp121r01qn3046hkk0
FINNHUB_ENABLED=true

# Financial Modeling Prep — https://financialmodelingprep.com/
FMP_API_KEY="your-fmp-api-key-here"
FMP_ENABLED=true

# --- News APIs ---------------------------------------------------------------
# NewsAPI — https://newsapi.org/
NEWSAPI_KEY="your-newsapi-key-here"
NEWSAPI_ENABLED=true

# Google News RSS — No key required
GOOGLE_NEWS_ENABLED=true

# --- Vector Database ---------------------------------------------------------
CHROMA_PERSIST_DIR="./storage/chroma"
CHROMA_COLLECTION_NAME="financial_documents"

# --- Storage -----------------------------------------------------------------
UPLOAD_DIR="./storage/uploads"
REPORTS_DIR="./storage/reports"
EXPORTS_DIR="./storage/exports"
TEMP_DIR="./storage/temporary"
MAX_UPLOAD_SIZE_MB=50

# --- Embedding Model ---------------------------------------------------------
EMBEDDING_MODEL="all-MiniLM-L6-v2"

# --- Analysis Settings -------------------------------------------------------
ANALYSIS_TIMEOUT_SECONDS=120
MAX_CONCURRENT_AGENTS=5
RETRIEVAL_TOP_K=10
BM25_WEIGHT=0.4
VECTOR_WEIGHT=0.6
