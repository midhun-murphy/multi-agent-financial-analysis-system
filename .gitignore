# =============================================================================
# .gitignore — Multi-Agent Financial Statement Analysis System
# =============================================================================

# --- Virtual Environment -----------------------------------------------------
.venv/
venv/
env/
ENV/

# --- Environment Files (NEVER commit) ----------------------------------------
.env
.env.local
.env.production
.env.staging

# --- Python Cache ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
wheels/
pip-wheel-metadata/
share/python-wheels/
.installed.cfg
lib/
lib64/
MANIFEST

# --- Testing & Coverage ------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover

# --- Type Checking -----------------------------------------------------------
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/

# --- Storage (generated files) -----------------------------------------------
storage/uploads/*
storage/reports/*
storage/exports/*
storage/temporary/*
storage/chroma/
!storage/uploads/.gitkeep
!storage/reports/.gitkeep
!storage/exports/.gitkeep
!storage/temporary/.gitkeep

# --- ChromaDB ----------------------------------------------------------------
chroma/
*.chroma

# --- IDE & Editor ------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Logs --------------------------------------------------------------------
*.log
logs/

# --- Jupyter -----------------------------------------------------------------
.ipynb_checkpoints
*.ipynb

# --- Distribution ------------------------------------------------------------
*.tar.gz
*.zip
